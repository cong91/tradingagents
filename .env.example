# Control panel storage (PostgreSQL is required; there is no SQLite fallback).
# docker compose builds TRADINGAGENTS_DATABASE_URL for the api service from the
# POSTGRES_* values below; running uvicorn outside Docker needs both set.
#POSTGRES_DB=tradingagents
#POSTGRES_USER=tradingagents
#POSTGRES_PASSWORD=change-me
#TRADINGAGENTS_DATABASE_URL=postgresql://tradingagents:change-me@127.0.0.1:5432/tradingagents
#TRADINGAGENTS_API_PORT=8000
#TRADINGAGENTS_WEB_PORT=3000

# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# SEC EDGAR (US company filings, point-in-time). No key; a contact address SEC can reach you at.
#SEC_EDGAR_USER_AGENT=Your Name your@email.com

# FRED (Federal Reserve macro data). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# TypeSafe Jev: screens StockTwits and Reddit posts for the Sentiment Analyst. Optional.
#TYPESAFE_API_KEY=
#TYPESAFE_DEFAULT_MODEL=jev-latest

# Custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp). Local servers need no key.
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (pip install ".[bedrock]"). Bearer token, or the AWS credential chain; set the region either way.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# Remote Ollama server. Unset uses http://localhost:11434/v1.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Override these DEFAULT_CONFIG keys. Provider, models, language and round counts also skip their CLI prompt.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
#TRADINGAGENTS_LLM_BACKEND_URL=
# Per-tier provider overrides: unset follows LLM_PROVIDER / LLM_BACKEND_URL.
# Lets the quick tier (analysts/researchers/trader/risk voices) and the deep
# tier (research manager/portfolio manager) use different providers, each with
# its own API key (e.g. ZHIPU_API_KEY for glm + ANTHROPIC_API_KEY for anthropic).
#TRADINGAGENTS_QUICK_PROVIDER=
#TRADINGAGENTS_DEEP_PROVIDER=
#TRADINGAGENTS_QUICK_BACKEND_URL=
#TRADINGAGENTS_DEEP_BACKEND_URL=
# OpenRouter only: per-tier fallback chain (comma-separated model IDs tried
# after the tier's primary model when it is rate-limited or unavailable).
# OpenRouter accepts at most 3 models per request, primary included.
#TRADINGAGENTS_QUICK_FALLBACK_MODELS=recursive/flint-v1.0:free,anthropic/claude-haiku-5.5
#TRADINGAGENTS_DEEP_FALLBACK_MODELS=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Paths and alpha benchmark. Unset uses ~/.tradingagents and the regional index.
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=
#TRADINGAGENTS_BENCHMARK_TICKER=SPY

# Lower temperature means less run-to-run variation on models that honor it.
#TRADINGAGENTS_TEMPERATURE=0.0

# Bound each LLM request so a stalled relay cannot hold a run forever.
# Keep below the reverse-proxy read timeout of the selected endpoint.
#TRADINGAGENTS_LLM_TIMEOUT=60

# Retry budget for every LLM SDK. Raise it to ride out 429 throttling.
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# Cap output tokens to bound a model that runs long and trips a timeout.
#TRADINGAGENTS_MAX_TOKENS=8192

# Reasoning depth per provider; setting one skips its prompt.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high

# Execution bridge (L1 ccxt). Live needs TWO independent gates:
# exec_live=True armed in code (NOT settable here) and this env flag, read at
# execute time, fail-closed (only true/1/yes/on counts).
#TRADINGAGENTS_EXEC_LIVE=false
#TRADINGAGENTS_EXEC_QUOTE_CURRENCY=USDT
#TRADINGAGENTS_EXEC_LOG_PATH=

# Execution bridge L2: venue and risk limits. TRADINGAGENTS_EXEC_AUTO_CONFIRM
# and TRADINGAGENTS_EXEC_DERIVATIVES below are env GATES: they only have an
# effect when the matching config key (exec_auto_confirm / exec_derivatives)
# is ALSO armed as a literal True in code — arm both halves only after a
# dry-run schedule has run clean.
#TRADINGAGENTS_EXEC_EXCHANGE_ID=binance
# Binance only accepts these two validated URLs. Demo is the default. Switching
# to production requires changing this URL AND the matching key/secret pair;
# live execution gates remain independent and closed unless explicitly armed.
#TRADINGAGENTS_EXEC_BASE_URL=https://demo-api.binance.com
# Non-Binance exchanges may use ccxt sandbox mode; ignored for Binance.
#TRADINGAGENTS_EXEC_SANDBOX=false
#TRADINGAGENTS_RISK_MAX_DAILY_LOSS_PCT=5.0
#TRADINGAGENTS_RISK_MAX_POSITION_PCT_PER_ASSET=25.0
#TRADINGAGENTS_RISK_MAX_TOTAL_EXPOSURE_PCT=80.0
#TRADINGAGENTS_RISK_MAX_CONSECUTIVE_LOSS_COUNT=3
#TRADINGAGENTS_RISK_MAX_DERIVATIVES_LEVERAGE=1.0
#TRADINGAGENTS_RISK_MAX_DERIVATIVES_EXPOSURE_PCT=0.0
# Hard ceilings on the futures terms the decision agents propose. A proposal
# above them is REFUSED, never silently resized. The two *_FRACTION keys are
# the fallback sizing for CLI/script orders that carry no agent proposal.
#TRADINGAGENTS_RISK_DERIVATIVES_MAX_RISK_FRACTION=0.02
#TRADINGAGENTS_RISK_DERIVATIVES_MAX_MARGIN_FRACTION=0.5
#TRADINGAGENTS_RISK_DERIVATIVES_RISK_FRACTION=0.01
#TRADINGAGENTS_RISK_DERIVATIVES_MARGIN_FRACTION=0.25
# Futures profit protection policy (does NOT open any live/derivatives gate).
# Applies only to bot-managed positions with a durable bracket task. The server
# mutates Binance conditional legs only when BOTH derivatives gates and BOTH
# live gates are already open; stop updates are monotonic and venue-confirmed.
# R is initial risk = actual fill entry to the original stop.
#TRADINGAGENTS_RISK_DERIVATIVES_PROFIT_PROTECTION_ENABLED=true
#TRADINGAGENTS_RISK_DERIVATIVES_BREAK_EVEN_R=1.0
#TRADINGAGENTS_RISK_DERIVATIVES_LOCK_PROFIT_R=2.0
#TRADINGAGENTS_RISK_DERIVATIVES_TRAIL_START_R=3.0
#TRADINGAGENTS_RISK_DERIVATIVES_TRAIL_DISTANCE_R=1.0
#TRADINGAGENTS_RISK_DERIVATIVES_TARGET_EXTENSION_R=1.0
# Minimum stop advance (in R) before a trailing update replaces the leg; a mark
# older than the max age is refused instead of driving a stale-price mutation.
#TRADINGAGENTS_RISK_DERIVATIVES_MIN_STOP_MOVE_R=0.1
#TRADINGAGENTS_RISK_DERIVATIVES_MARK_MAX_AGE_SECONDS=120
# Deliberate scale-out: two profit tranches at R multiples, remainder runs on
# the trailing stop. Fractions are of the ORIGINAL position; they must leave a
# positive runner. OFF by default (a single bracket is used).
#TRADINGAGENTS_RISK_DERIVATIVES_SCALE_OUT_ENABLED=false
#TRADINGAGENTS_RISK_DERIVATIVES_SCALE_OUT_FIRST_R=1.0
#TRADINGAGENTS_RISK_DERIVATIVES_SCALE_OUT_FIRST_FRACTION=0.33
#TRADINGAGENTS_RISK_DERIVATIVES_SCALE_OUT_SECOND_R=2.0
#TRADINGAGENTS_RISK_DERIVATIVES_SCALE_OUT_SECOND_FRACTION=0.33
#TRADINGAGENTS_EXEC_AUTO_CONFIRM=false
#TRADINGAGENTS_EXEC_DERIVATIVES=false

# Exchange API credentials for live execution — env only, never commit real
# values. Binance Demo URL requires BINANCE_DEMO_API_KEY / BINANCE_DEMO_SECRET.
# For https://api.binance.com use BINANCE_API_KEY / BINANCE_SECRET instead.
# Change URL and the corresponding pair together; backend restart applies both.
#BINANCE_DEMO_API_KEY=
#BINANCE_DEMO_SECRET=
#BINANCE_API_KEY=
#BINANCE_SECRET=
